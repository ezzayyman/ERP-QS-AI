# GMI FloorTakeoff - Environment Variables Configuration

# Server Environment
APP_ENV=development
PORT=8000
HOST=0.0.0.0

# Database Configuration
# Default is SQLite for local development:
DATABASE_URL=sqlite:///./backend/storage/gmi_floortakeoff.db
# For PostgreSQL Production, use:
# DATABASE_URL=postgresql://gmi_user:secure_password@localhost:5432/gmi_floortakeoff

# Security & CORS
SECRET_KEY=change-this-in-production-gmi-secret-key-32chars
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Storage Paths
STORAGE_DIR=backend/storage
RENDER_DPI=150

# GMI Company Branding & Defaults
COMPANY_NAME="GMI Design and Implementation LLC"
DEFAULT_CURRENCY=AED
DEFAULT_WASTE_PCT=10.0
